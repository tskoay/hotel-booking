# Copy to .env.local and fill in real values.
# Required keys are marked. Phase notes indicate when each becomes load-bearing.

# ---------- Supabase (Phase 0) ----------
# Find these in your Supabase dashboard:
#   URL + Publishable: Project Settings -> API Keys
#   Secret: Project Settings -> API Keys -> Secret keys (create one if none)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Only needed for the Supabase CLI (gen types, db push). Local dev runtime does not use it.
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Stripe (Phase 3) ----------
# Test mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---------- Resend (Phase 3) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Must be a verified sender on a verified domain
RESEND_FROM_EMAIL=bookings@example.com

# ---------- Sentry (Phase 0, optional until launch) ----------
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------- App ----------
# In production, set to the canonical site URL (https://your-hotel.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
